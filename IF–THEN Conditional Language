Build a Lexer and Parser for a simple conditional language using the syntax:
IF <condition> THEN <action>. The condition compares two numbers (e.g., x > 5),
and the action is either PRINT "message" or SKIP. The parser should evaluate each statement and execute the action only if the condition is true.

Required Tokens
IF
THEN
PRINT
SKIP
NUMBER
STRING
GT
LT
EQ
All keywords are reserved. EQ matches ==.

Grammar Rules
program : program stmt | stmt stmt : IF cond THEN action cond : NUMBER GT NUMBER | NUMBER LT NUMBER | NUMBER EQ NUMBER action : PRINT STRING | SKIP

Sample Input
IF 10 > 3 THEN PRINT "Big" IF 5 > 9 THEN PRINT "Unreachable" IF 7 == 7 THEN PRINT "Equal" IF 2 < 1 THEN SKIP

Expected Output
Big Equal
Hint: Use empty productions pattern knowledge from Section 4. The action rule for SKIP simply does nothing.
Store the condition result in p[0] and pass it up to stmt.

#############################################################################################################


import ply.lex as lex
import ply.yacc as yacc

# ─── LEXER ────────────────────────────────────────────
reserved = {
    'IF': 'IF', 'THEN': 'THEN',
    'PRINT': 'PRINT', 'SKIP': 'SKIP'
}
tokens = ['NUMBER', 'STRING', 'GT', 'LT', 'EQ'] + list(reserved.values())

def t_ID(t):
    r'[A-Za-z_][A-Za-z0-9_]*'
    t.type = reserved.get(t.value.upper(), 'ID')
    t.value = t.value.upper()
    return t

def t_NUMBER(t):
    r'\d+'
    t.value = int(t.value)
    return t

def t_STRING(t):
    r'"[^"]*"'
    t.value = t.value[1:-1]
    return t

def t_EQ(t):
    r'=='
    return t

t_GT = r'>'
t_LT = r'<'
t_ignore = ' \t\n'

def t_error(t):
    print(f"Illegal character: '{t.value[0]}'")
    t.lexer.skip(1)

lexer = lex.lex()

# ─── PARSER ───────────────────────────────────────────
def p_program(p):
    '''program : program stmt 
      | stmt'''
    pass

def p_stmt(p):
    '''stmt : IF cond THEN action'''
    condition = p[2]
    action    = p[4]
    if condition and action is not None:
        print(action)

def p_cond(p):
    '''cond : NUMBER GT NUMBER
           | NUMBER LT NUMBER
           | NUMBER EQ NUMBER'''
    if   p[2] == '>':  p[0] = p[1] >  p[3]
    elif p[2] == '<':  p[0] = p[1] <  p[3]
    elif p[2] == '==': p[0] = p[1] == p[3]

def p_action_print(p):
    '''action : PRINT STRING'''
    p[0] = p[2]       # return message

def p_action_skip(p):
    '''action : SKIP'''
    p[0] = None

def p_error(p):
    print(f"Syntax error: {p}")

parser = yacc.yacc()

# ─── TEST ─────────────────────────────────────────────
data = '''IF 10 > 3  THEN PRINT "Big"
IF 5  > 9  THEN PRINT "Unreachable"
IF 7  == 7 THEN PRINT "Equal"
IF 2  < 1  THEN SKIP'''

parser.parse(data, lexer=lexer)
